rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // No login (same as the original Base44 app): anyone with the site link can read and write.
    // Only the app's own collections are open; everything else is denied.
    match /trips/{id} { allow read, write: if true; }
    match /expenses/{id} { allow read, write: if true; }
    match /reminder_settings/{id} { allow read, write: if true; }
  }
}

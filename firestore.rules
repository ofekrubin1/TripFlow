rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Google accounts allowed to read and write all TripFlow data. Add emails here, then publish.
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ofekrubin1996@gmail.com'];
    }
    match /{document=**} {
      allow read, write: if allowed();
    }
  }
}
